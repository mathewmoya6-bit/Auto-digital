<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Auto-D Onsite Valuation</title>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b1426;--panel:#121e36;--line:#26365a;--tx:#e8ecf4;--mut:#8d9bb8;--amb:#f5a623;--ok:#3fb58a;--bad:#e5604d;--r:10px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.45 'Public Sans',system-ui,sans-serif;padding-bottom:120px}
h1,h2,h3{margin:0;font-weight:800}
.wrap{max-width:860px;margin:0 auto;padding:16px}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
.brand{font-weight:800;font-size:18px}.brand span{color:var(--amb)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:16px;margin:14px 0}
.card h2{font-size:16px;margin-bottom:10px;color:var(--amb)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
label{display:block;font-size:12px;color:var(--mut);font-weight:600}
input,select,textarea{width:100%;margin-top:4px;padding:10px;background:#0b1426;border:1px solid var(--line);border-radius:8px;color:var(--tx);font:inherit}
input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--amb);outline-offset:1px}
button{font:inherit;font-weight:700;padding:10px 16px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--tx);cursor:pointer}
button.pri{background:var(--amb);border-color:var(--amb);color:#1a1200}
button.lnk{border:0;padding:4px;color:var(--amb);text-decoration:underline}
.auth{max-width:400px;margin:8vh auto}
.msg{padding:10px;border-radius:8px;margin:10px 0;background:#2a1c1c;border:1px solid var(--bad);color:#ffb4a8}
.msg.good{background:#12281f;border-color:var(--ok);color:#a6ecd0}
.it{display:grid;grid-template-columns:1fr 110px;gap:6px 8px;padding:10px 0;border-top:1px solid var(--line)}
.it input{grid-column:1/3;margin:0}
.it select{margin:0}
.st.ok{border-color:var(--ok)}.st.issue{border-color:var(--bad);background:#2a1c1c}
.rq{color:var(--amb);font-size:11px;font-weight:600}
#bar{position:fixed;left:0;right:0;bottom:0;background:#0f1a30;border-top:2px solid var(--amb);padding:10px 16px;z-index:5}
#bar .in{max-width:860px;margin:auto;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between}
.big{font-size:22px;font-weight:800;color:var(--amb)}
.sm{font-size:12px;color:var(--mut)}
.row{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid var(--line)}
.row b{white-space:nowrap}
.neg{color:var(--bad)}.pos{color:var(--ok)}
.list .row{cursor:pointer}
.tag{font-size:11px;padding:2px 8px;border-radius:99px;border:1px solid var(--line)}
.tag.final{border-color:var(--ok);color:var(--ok)}
#toast{position:fixed;top:14px;right:14px;background:var(--ok);color:#04150e;padding:10px 14px;border-radius:8px;font-weight:700;z-index:9;display:none}
.rep{background:#fff;color:#111;padding:24px;border-radius:var(--r)}
.rep .row{border-color:#ddd}.rep h2,.rep h3{color:#111}.rep .sm{color:#555}.rep .big{color:#111}
@media print{body{background:#fff;padding:0}.noprint,.top,#bar{display:none!important}.rep{padding:0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div id="toast"></div>
<div id="app"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script>
const SB_URL='https://xgkdbithhlvoqjnqvfmj.supabase.co', SB_KEY='PASTE_SUPABASE_ANON_KEY';
const sb=supabase.createClient(SB_URL,SB_KEY);
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KES=x=>'KES '+Math.round(x||0).toLocaleString('en-KE');
const num=x=>parseFloat(x)||0;
const toast=m=>{const t=$('#toast');t.textContent=m;t.style.display='block';setTimeout(()=>t.style.display='none',2200)};

/* Purpose profiles. Level strings below follow this order: DUTY INS CLAIM BANK SALE LEGAL FLEET AUCT */
const PK=['DUTY','INS','CLAIM','BANK','SALE','LEGAL','FLEET','AUCT'];
const P={
 DUTY:{n:'Import duty (KRA)',base:'CRSP',adj:'dep',hc:0,days:30},
 INS:{n:'Insurance (agreed value)',adj:'mil cond acc use acd',hc:0,days:90},
 CLAIM:{n:'Insurance claim / total loss',adj:'mil cond acc use acd',hc:0,days:30},
 BANK:{n:'Bank / SACCO collateral',adj:'mil cond use acd dem',hc:25,days:90},
 SALE:{n:'Buy, sell or trade-in',adj:'mil cond acc use acd dem',hc:0,days:14},
 LEGAL:{n:'Legal, court or succession',adj:'mil cond acc use acd',hc:0,days:0},
 FLEET:{n:'Fleet / corporate',adj:'dep cond use',hc:0,days:180},
 AUCT:{n:'Auction / reserve price',adj:'mil cond acd dem',hc:25,days:30}};
const SECS=[
 ['Admin and consent',[['consent','Data Protection Act consent recorded','RRRRRRRR']]],
 ['Identity and documents',[
  ['chassis','Chassis/VIN matches logbook or export certificate','RRRRRRRR'],
  ['engno','Engine number matches documents','ORRRORRR'],
  ['plate','Plate number and type verified','-RRRRRRR'],
  ['acc_list','Optional equipment and accessories listed','-RROROOO'],
  ['logbook','Logbook name matches seller ID','-RRRRRRR'],
  ['search','Official search clear (no caveat, lien, police stop)','-OORRROR'],
  ['export','Export certificate / customs entry seen','R--OOO-O'],
  ['preexp','Pre-export inspection certificate (JEVIC/QISJ/EAA)','R-------'],
  ['dutypd','Proof of duty paid (KRA)','-OOROOOR'],
  ['ntsa','Valid NTSA inspection','-OOOO-RO'],
  ['insur','Insurance history / current cover','-RRROORO'],
  ['service','Service records','-OOORORO'],
  ['acc_hist','Accident / repair history declared','-RRRRROR'],
  ['police','Police abstract','--R--O--'],
  ['lender','Financier consent / settlement figure','--OROOOO'],
  ['court','Court order / letters of administration','-----R--'],
  ['asset','Asset register entry and acquisition cost','------R-']]],
 ['Mileage',[
  ['odo','Odometer reading photographed','-RRRRRRR'],
  ['odo_ok','Odometer genuine (no rollback signs)','-RRRRROR']]],
 ['Exterior',[
  ['paint','Paint, repaints, mismatched panels','-RRRRROR'],
  ['dents','Dents and scratches','-RRRRROR'],
  ['rust','Rust / corrosion (sills, arches, underbody)','-RRRRROR'],
  ['gaps','Panel gaps (accident repair sign)','-RRRRROR'],
  ['glass','Glass: chips, cracks, replaced','-RRORROO'],
  ['lights','Lights, mirrors, bumpers','-RRORROO'],
  ['tyres','Tyres: tread, wear, spare','-RRRRRRO']]],
 ['Interior and electronics',[
  ['seats','Seats, upholstery, headliner','-RRORROO'],
  ['dashwear','Dash, steering, pedal wear vs mileage','-RRRRROR'],
  ['elec','AC, windows, locks, infotainment','-ORORROO'],
  ['warn','Dashboard warning lights','-RRRRRRR'],
  ['flood','Odour / flood signs','-RRRRROR'],
  ['airbag','Airbags / SRS status','-RRRRRRR']]],
 ['Engine and mechanical',[
  ['leaks','Fluid leaks (oil, coolant, transmission)','-ORRRRRR'],
  ['engine','Engine noise, smoke, cold start','-ORRRRRR'],
  ['gearbox','Gearbox / clutch','-ORRRRRR'],
  ['susp','Suspension and steering play','-ORRRRRO'],
  ['brakes','Brakes','-ORRRRRO'],
  ['batt','Battery, belts, hoses','-OOORORO'],
  ['hybrid','Hybrid / EV battery health (if fitted)','-OORRORR']]],
 ['Structure and accident',[
  ['struct','Chassis alignment, welds, repairs','-RRRRROR'],
  ['fire','Flood or fire damage signs','-RRRRROR'],
  ['dmg_est','Damage extent and repair estimate','--R--O-O']]],
 ['Road test and evidence',[
  ['road','Road test: acceleration, braking, steering pull','-OORRRRO'],
  ['photos','Photos: 4 corners, chassis plate, engine bay, odometer','-RRRRRRR'],
  ['scans','Document scans (logbook, ID, KRA PIN)','RRRRORRR'],
  ['geo','Geo-tagged location captured','-ORR-ROO']]]];
const INSP=['Mileage','Exterior','Interior and electronics','Engine and mechanical','Structure and accident'];
const lvl=(row,pu)=>row[2][PK.indexOf(pu)];
const ITEMS=SECS.flatMap(s=>s[1].map(r=>({sec:s[0],code:r[0],label:r[1],lv:r[2]})));
const M={v:'vehicle',i:'inputs',a:'answers',n:'notes'};
const S={user:null,prof:null,val:null,r:null,list:[]};
const get=k=>{const[a,b]=k.split('.');return S.val[M[a]][b]??''};

/* ---------- Engine ---------- */
function calc(v){
 const p=P[v.purpose],i=v.inputs,A=v.answers,r={lines:[],stops:[],warns:[],missing:[]};
 const has=k=>p.adj.split(' ').includes(k);
 const comps=(i.comps||'').split(/[\s,;]+/).map(num).filter(x=>x>0).sort((a,b)=>a-b);
 r.n=comps.length;
 let base=0;
 if(p.base==='CRSP'){base=num(i.crsp);if(!base)r.stops.push('No CRSP value entered: duty valuation is blocked.')}
 else{
  let c=comps.length>=5?comps.slice(1,-1):comps;
  base=c.length?c[Math.floor((c.length-1)/2)]/2+c[Math.floor(c.length/2)]/2:num(i.manual);
  if(!base)r.stops.push('Enter market comparables or a base value.');
  if(r.n<3)r.warns.push('Fewer than 3 comparables: low confidence'+(['CLAIM','BANK','LEGAL'].includes(v.purpose)?'. Valuer override required.':'.'));
 }
 r.base=base;let sub=base;
 const add=(l,amt)=>{if(amt){r.lines.push([l,amt]);sub+=amt}};
 if(has('dep'))add(`Depreciation ${num(i.dep)}%`,-base*num(i.dep)/100);
 if(has('mil')){
  const age=Math.max(1,new Date().getFullYear()-num(v.vehicle.yom)),km=num(v.vehicle.mileage);
  if(v.vehicle.yom&&km){const pct=Math.max(-15,Math.min(15,(age*15000-km)/10000*0.5));add(`Mileage vs expected ${(age*15000).toLocaleString()} km (${pct.toFixed(1)}%)`,base*pct/100)}
  else r.warns.push('Year of manufacture and mileage are needed for the mileage adjustment.');
 }
 if(has('cond')){const c={Excellent:5,Good:0,Fair:-8,Poor:-20}[i.cond];if(c===undefined)r.warns.push('Condition grade not selected.');else add(`Condition: ${i.cond} (${c}%)`,base*c/100)}
 if(has('use')){const u={Private:0,Commercial:-8,Taxi:-15,Rental:-10,Fleet:-8}[v.vehicle.usage]||0;add(`Usage: ${v.vehicle.usage||'not set'} (${u}%)`,base*u/100)}
 if(has('dem')){const d={High:4,Normal:0,Low:-6}[i.dem]||0;add(`Market demand: ${i.dem||'Normal'} (${d}%)`,base*d/100)}
 if(has('acc'))add('Accessories',num(i.acc));
 if(has('acd'))add(`Accident / repair deduction ${num(i.acd)}%`,-base*num(i.acd)/100);
 const hc=num(i.hc);r.sub=sub;
 r.final=hc?sub*(1-hc/100):sub;if(hc)r.lines.push([`Forced-sale haircut ${hc}%`,r.final-sub]);
 if(v.purpose==='CLAIM'){
  const rep=num(i.repair),sal=num(i.salvage);r.ratio=r.final?rep/r.final:0;
  r.net=r.final-sal;
  if(rep&&r.ratio>0.7)r.warns.push(`Repair is ${(r.ratio*100).toFixed(0)}% of value: likely total loss.`);
 }
 /* hard stops and missing items */
 if(A.chassis!=='ok')r.stops.push('Chassis/VIN is not confirmed against the logbook or export certificate.');
 if(['BANK','SALE','LEGAL','AUCT'].includes(v.purpose)&&A.search==='issue')r.stops.push('Caveat, lien or police stop found on official search.');
 if(A.odo_ok==='issue')r.warns.push('Odometer tampering suspected: valuer sign-off required, confidence lowered.');
 let req=0;
 ITEMS.forEach(t=>{if(lvl(t,v.purpose)==='R'){req++;if(!A[t.code])r.missing.push(t.label)}});
 r.conf=Math.max(5,Math.round(100-40*r.missing.length/Math.max(req,1)-(p.base!=='CRSP'&&r.n<3?20:0)-(A.odo_ok==='issue'?15:0)-(r.stops.length?30:0)));
 const sp=(4+(100-r.conf)*0.12)/100;r.lo=r.final*(1-sp);r.hi=r.final*(1+sp);
 const ins=ITEMS.filter(t=>INSP.includes(t.sec)&&A[t.code]&&A[t.code]!=='na'&&!['odo'].includes(t.code));
 const bad=ins.filter(t=>A[t.code]==='issue').length;
 r.hint=ins.length>=6?(bad/ins.length<=.05?'Excellent':bad/ins.length<=.15?'Good':bad/ins.length<=.35?'Fair':'Poor'):'';
 r.days=p.days;
 return r;
}
function recalc(){
 const v=S.val,r=S.r=calc(v);
 $('#bar').innerHTML=`<div class="in"><div><div class="sm">${esc(P[v.purpose].n)}</div><div class="big">${KES(r.final)}</div><div class="sm">Range ${KES(r.lo)} to ${KES(r.hi)} · Confidence ${r.conf}%</div></div>
 <div class="sm" style="max-width:300px">${r.stops.length?`<span class="neg">${r.stops.length} blocking: ${esc(r.stops[0])}</span>`:r.missing.length?`${r.missing.length} required checks unanswered`:'<span class="pos">Ready to finalise</span>'}</div>
 <div><button onclick="save(false)">Save draft</button> <button class="pri" onclick="save(true)">Finalise and report</button></div></div>`;
 const h=$('#hint');if(h)h.textContent=r.hint?`Checklist suggests: ${r.hint}`:'';
}

/* ---------- Auth ---------- */
function authView(mode='login',msg='',good=false){
 const su=mode==='signup';
 $('#app').innerHTML=`<div class="auth wrap"><div class="brand">Auto-<span>D</span> Onsite Valuation</div>
 <p class="sm">Sign in as a valuation officer to start an on-site inspection.</p>
 <div class="card"><h2>${su?'Create officer account':'Officer login'}</h2>${msg?`<div class="msg ${good?'good':''}">${esc(msg)}</div>`:''}
 <form id="af">${su?`<label>Full name<input name="full_name" required autocomplete="name"></label><br><label>Phone<input name="phone" type="tel" required autocomplete="tel"></label><br><label>Valuer licence number<input name="licence_no" placeholder="Optional for trainees"></label><br>`:''}
 <label>Email<input name="email" type="email" required autocomplete="email"></label><br>
 <label>Password<input name="password" type="password" minlength="8" required autocomplete="${su?'new':'current'}-password"></label><br>
 <button class="pri" style="width:100%">${su?'Create account':'Log in'}</button></form>
 <p class="sm">${su?'Already registered?':'New officer?'} <button class="lnk" onclick="authView('${su?'login':'signup'}')">${su?'Log in':'Create an account'}</button></p></div></div>`;
 $('#af').onsubmit=async e=>{e.preventDefault();const f=Object.fromEntries(new FormData(e.target));
  if(su){const{data,error}=await sb.auth.signUp({email:f.email,password:f.password,options:{data:{app:'onsite_officer',full_name:f.full_name,phone:f.phone,licence_no:f.licence_no}}});
   if(error)return authView('signup',error.message);
   return authView('login',data.session?'Account created. An admin must approve it before you can log in.':'Account created. Confirm your email, then wait for admin approval.',true)}
  const{error}=await sb.auth.signInWithPassword(f);if(error)return authView('login',error.message);boot()};
}
async function boot(){
 const{data:{session}}=await sb.auth.getSession();
 if(!session)return authView();
 S.user=session.user;
 const{data}=await sb.from('valuation_officers').select('*').eq('id',S.user.id).maybeSingle();
 if(!data){await sb.auth.signOut();return authView('login','This account is not registered as a valuation officer.')}
 if(!data.active){await sb.auth.signOut();return authView('login','Your account is waiting for admin approval.')}
 S.prof=data;home();
}
const logout=async()=>{await sb.auth.signOut();S.val=null;authView()};
const topbar=()=>`<div class="top noprint"><div class="brand">Auto-<span>D</span> Onsite</div><div class="sm">${esc(S.prof.full_name)}${S.prof.licence_no?' · '+esc(S.prof.licence_no):''} <button class="lnk" onclick="logout()">Log out</button></div></div>`;

/* ---------- Home ---------- */
async function home(){
 S.val=null;
 $('#app').innerHTML=topbar()+`<div class="wrap"><div class="card"><h2>New valuation</h2><div class="grid"><label>Purpose<select id="np">${PK.map(k=>`<option value="${k}">${P[k].n}</option>`).join('')}</select></label><div style="align-self:end"><button class="pri" onclick="newVal()">Start inspection</button></div></div></div>
 <div class="card list"><h2>My valuations</h2><div id="lst" class="sm">Loading…</div></div></div><div id="bar" style="display:none"></div>`;
 const{data,error}=await sb.from('onsite_valuations').select('*').eq('officer_id',S.user.id).order('updated_at',{ascending:false}).limit(50);
 if(error)return $('#lst').textContent=error.message;
 S.list=data;
 $('#lst').innerHTML=data.length?data.map((d,n)=>`<div class="row" onclick="openRow(${n})"><span>${esc(d.vehicle.make||'')} ${esc(d.vehicle.model||'')} ${esc(d.vehicle.plate||d.vehicle.chassis||'')}<br><span class="sm">${esc(d.ref)} · ${P[d.purpose].n} · ${new Date(d.updated_at).toLocaleDateString('en-KE')}</span></span><span><span class="tag ${d.status}">${d.status}</span><br><b>${d.final_value?KES(d.final_value):''}</b></span></div>`).join(''):'No valuations yet. Start one above.';
}
function newVal(){const pu=$('#np').value;S.val={purpose:pu,vehicle:{},inputs:{date:new Date().toISOString().slice(0,10),hc:P[pu].hc},answers:{},notes:{}};formView()}
function openRow(n){const d=S.list[n];S.val={id:d.id,ref:d.ref,purpose:d.purpose,status:d.status,vehicle:d.vehicle,inputs:d.inputs,answers:d.answers,notes:d.notes};d.status==='final'?reportView():formView()}

/* ---------- Form ---------- */
function F(k,l,o){
 const val=get(k);
 if(Array.isArray(o))return`<label>${l}<select data-k="${k}"><option value=""></option>${o.map(x=>`<option${x===val?' selected':''}>${x}</option>`).join('')}</select></label>`;
 return`<label>${l}<input data-k="${k}" type="${o||'text'}" ${o==='number'?'step="any" inputmode="decimal"':''} value="${esc(val)}"></label>`;
}
function formView(){
 const v=S.val,p=P[v.purpose],has=k=>p.adj.split(' ').includes(k);
 const row=t=>{const a=v.answers[t.code]||'',L=lvl(t,v.purpose);
  return`<div class="it"><div>${esc(t.label)} ${L==='R'?'<span class="rq">required</span>':''}</div><select class="st ${a}" data-k="a.${t.code}"><option value="">Not checked</option><option value="ok"${a==='ok'?' selected':''}>OK</option><option value="issue"${a==='issue'?' selected':''}>Issue</option><option value="na"${a==='na'?' selected':''}>N/A</option></select><input data-k="n.${t.code}" placeholder="Note" value="${esc(v.notes[t.code]||'')}"></div>`};
 $('#app').innerHTML=topbar()+`<div class="wrap">
 <button class="lnk noprint" onclick="home()">Back to list</button>
 <h1>${esc(p.n)}</h1><div class="sm">${v.ref?esc(v.ref):'New valuation'} · ${p.base==='CRSP'?'Reference: KRA CRSP':'Reference: market comparables'}</div>
 <div class="card"><h2>Vehicle</h2><div class="grid">
 ${F('v.make','Make')}${F('v.model','Model')}${F('v.variant','Variant / trim')}${F('v.chassis','Chassis / VIN')}${F('v.engine_no','Engine number')}${F('v.plate','Plate number')}
 ${F('v.yom','Year of manufacture','number')}${F('v.reg_year','Year of first registration','number')}${F('v.cc','Engine cc','number')}
 ${F('v.fuel','Fuel',['Petrol','Diesel','Hybrid','Electric'])}${F('v.trans','Transmission',['Manual','Automatic','CVT'])}${F('v.drive','Drivetrain',['2WD','4WD','AWD'])}
 ${F('v.origin','Import status',['Japan import','UK used','Locally assembled','Other'])}${F('v.colour','Colour')}${F('v.owner','Owner / requester')}
 ${F('v.mileage','Odometer (km)','number')}${F('v.usage','Usage type',['Private','Commercial','Taxi','Rental','Fleet'])}${F('i.date','Valuation date','date')}
 </div><p><button class="noprint" onclick="geo()">Capture location</button> <span class="sm" id="geo">${esc(v.inputs.location||'')}</span></p></div>
 <div class="card"><h2>Pricing inputs</h2><div class="grid">
 ${p.base==='CRSP'?F('i.crsp','CRSP value (KES), from the current KRA list','number'):F('i.manual','Base value if no comparables (KES)','number')}
 ${has('dep')?F('i.dep','Depreciation % (KRA schedule or book)','number'):''}
 ${has('cond')?F('i.cond','Condition grade',['Excellent','Good','Fair','Poor']):''}
 ${has('dem')?F('i.dem','Market demand',['High','Normal','Low']):''}
 ${has('acc')?F('i.acc','Accessories value (KES)','number'):''}
 ${has('acd')?F('i.acd','Accident / repair deduction %','number'):''}
 ${v.purpose==='CLAIM'?F('i.repair','Repair estimate (KES)','number')+F('i.salvage','Salvage value (KES)','number'):''}
 ${p.hc||v.purpose==='LEGAL'?F('i.hc','Forced-sale haircut %','number'):''}
 </div>
 ${p.base==='CRSP'?'<p class="sm">Verify the CRSP value and depreciation rate against the current KRA schedule before finalising.</p>':`<label style="margin-top:10px">Market comparables (KES, one per line, same make, model and year range)<textarea data-k="i.comps" rows="4">${esc(v.inputs.comps||'')}</textarea></label><p class="sm">Median is used. With 5 or more, the highest and lowest are dropped.</p>`}
 <p class="sm" id="hint"></p></div>
 ${SECS.map(([s,items])=>{const rows=items.filter(t=>lvl({2:t[2]},v.purpose)!=='-').map(t=>row({code:t[0],label:t[1],lv:t[2]}));return rows.length?`<div class="card"><h2>${s}</h2>${rows.join('')}</div>`:''}).join('')}
 <div class="card"><h2>Photos and notes</h2><input id="ph" type="file" accept="image/*" capture="environment" multiple>
 <p><button onclick="upl()">Upload photos</button> <span class="sm" id="pc">${(v.inputs.photos||[]).length} uploaded</span></p>
 <label>Valuer notes and assumptions<textarea data-k="i.remarks" rows="3">${esc(v.inputs.remarks||'')}</textarea></label></div></div><div id="bar"></div>`;
 recalc();
}
document.addEventListener('input',e=>{
 const k=e.target.dataset&&e.target.dataset.k;if(!k||!S.val)return;
 const[a,b]=k.split('.');S.val[M[a]][b]=e.target.value;
 if(a==='a')e.target.className='st '+e.target.value;
 recalc();
});
function geo(){navigator.geolocation.getCurrentPosition(p=>{const l=`${p.coords.latitude.toFixed(5)}, ${p.coords.longitude.toFixed(5)}`;S.val.inputs.location=l;$('#geo').textContent=l;S.val.answers.geo='ok';formView()},()=>toast('Location not available'))}
async function ensureSaved(){if(!S.val.id)await save(false,true);return S.val.id}
async function upl(){
 const fs=[...$('#ph').files];if(!fs.length)return toast('Choose photos first');
 if(!await ensureSaved())return;
 const v=S.val;v.inputs.photos=v.inputs.photos||[];
 for(const f of fs){const path=`${S.user.id}/${v.id}/${Date.now()}_${f.name.replace(/[^\w.]/g,'_')}`;
  const{error}=await sb.storage.from('valuation-photos').upload(path,f);
  if(error)return toast(error.message);v.inputs.photos.push(path)}
 $('#pc').textContent=v.inputs.photos.length+' uploaded';await save(false,true);toast('Photos uploaded');
}
async function save(fin,quiet){
 const v=S.val,r=S.r=calc(v);
 if(fin&&(r.stops.length||r.missing.length))return alert(r.stops.length?r.stops.join('\n'):`Answer all required checks first (${r.missing.length} left).`);
 if(fin&&!confirm('Finalise? A final valuation is locked and cannot be edited.'))return;
 const row={officer_id:S.user.id,purpose:v.purpose,status:fin?'final':'draft',vehicle:v.vehicle,inputs:v.inputs,answers:v.answers,notes:v.notes,result:r,final_value:Math.round(r.final),range_low:Math.round(r.lo),range_high:Math.round(r.hi),confidence:r.conf};
 if(v.id)row.id=v.id;
 const{data,error}=await sb.from('onsite_valuations').upsert(row).select().single();
 if(error)return alert(error.message);
 v.id=data.id;v.ref=data.ref;v.status=data.status;
 if(fin)reportView();else if(!quiet)toast('Draft saved');
}

/* ---------- Report ---------- */
function reportView(){
 const v=S.val,p=P[v.purpose],r=S.r=calc(v),i=v.inputs,ve=v.vehicle;
 const issues=ITEMS.filter(t=>v.answers[t.code]==='issue');
 const kv=(a,b)=>`<div class="row"><span>${a}</span><b>${esc(b||'-')}</b></div>`;
 const valid=p.days?new Date(new Date(i.date||Date.now()).getTime()+p.days*864e5).toLocaleDateString('en-KE'):'Date-specific';
 $('#app').innerHTML=topbar()+`<div class="wrap"><div class="noprint"><button onclick="home()">Back to list</button> <button class="pri" onclick="print()">Print or save as PDF</button></div>
 <div class="rep card"><div style="display:flex;justify-content:space-between"><div><h2>Vehicle Valuation Report</h2><div class="sm">${esc(p.n)} · Ref ${esc(v.ref||'')}</div></div><div class="brand">Auto-D</div></div>
 <h3 style="margin-top:14px">Result</h3><div class="big">${KES(r.final)}</div>
 <div class="sm">Range ${KES(r.lo)} to ${KES(r.hi)} · Confidence ${r.conf}% · Valid until ${valid}${v.purpose==='CLAIM'&&i.salvage?` · Net of salvage ${KES(r.net)}`:''}</div>
 <h3 style="margin-top:14px">Vehicle</h3>${kv('Make / model / variant',[ve.make,ve.model,ve.variant].filter(Boolean).join(' '))}${kv('Plate',ve.plate)}${kv('Chassis / VIN',ve.chassis)}${kv('Engine no.',ve.engine_no)}${kv('Year / registered',[ve.yom,ve.reg_year].filter(Boolean).join(' / '))}${kv('Engine, fuel, transmission',[ve.cc&&ve.cc+'cc',ve.fuel,ve.trans,ve.drive].filter(Boolean).join(', '))}${kv('Origin',ve.origin)}${kv('Odometer',ve.mileage&&Number(ve.mileage).toLocaleString()+' km')}${kv('Usage',ve.usage)}${kv('Owner / requester',ve.owner)}
 <h3 style="margin-top:14px">Calculation</h3>
 <div class="row"><span>${p.base==='CRSP'?'KRA CRSP base':`Market base (${r.n} comparables)`}</span><b>${KES(r.base)}</b></div>
 ${r.lines.map(l=>`<div class="row"><span>${esc(l[0])}</span><b class="${l[1]<0?'neg':'pos'}">${l[1]<0?'-':'+'}${KES(Math.abs(l[1]))}</b></div>`).join('')}
 ${issues.length?`<h3 style="margin-top:14px">Issues found</h3>${issues.map(t=>kv(esc(t.label),v.notes[t.code]||'Issue')).join('')}`:''}
 ${r.warns.length?`<h3 style="margin-top:14px">Warnings</h3>${r.warns.map(w=>`<div class="row"><span>${esc(w)}</span></div>`).join('')}`:''}
 ${i.remarks?`<h3 style="margin-top:14px">Notes and assumptions</h3><p>${esc(i.remarks)}</p>`:''}
 <p class="sm" style="margin-top:14px">Inspected ${esc(i.date||'')}${i.location?' at '+esc(i.location):''} by ${esc(S.prof.full_name)}${S.prof.licence_no?' (licence '+esc(S.prof.licence_no)+')':''}. ${(i.photos||[]).length} photos on file. This is a professional opinion of value as at the valuation date, based on the inspection and data above. It is not a guarantee of sale price.${v.purpose==='DUTY'?' Duty values are indicative: KRA assessment prevails.':''} Engine onsite-1.0.</p>
 <p style="margin-top:30px">Valuer signature: ______________________ Date: ____________</p></div></div>`;
}
boot();
</script>
