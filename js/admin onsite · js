/* Auto-D Admin: Onsite Valuations + Valuation Officer management.
   Load with <script src="admin-onsite.js"></script> just before </body> in admin.html.
   Uses the dashboard's own Supabase client (window.supabase) and styles. */
(function () {
  'use strict';
  const PN = { DUTY: 'Import duty', INS: 'Insurance', CLAIM: 'Claim / total loss', BANK: 'Bank collateral', SALE: 'Buy / sell', LEGAL: 'Legal', FLEET: 'Fleet', AUCT: 'Auction' };
  let officers = [], vals = [], meId = null, injected = false;
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const kes = n => 'KES ' + Math.round(Number(n) || 0).toLocaleString();
  const when = d => d ? new Date(d).toLocaleString() : '-';
  const db = () => (window.supabase && window.supabase.from ? window.supabase : null);
  const toast = (m, t = 'success') => {
    const c = $('toastContainer'); if (!c) return;
    const d = document.createElement('div'); d.className = 'toast toast-' + t; d.textContent = m;
    c.appendChild(d); setTimeout(() => d.remove(), 4000);
  };
  const log = a => db() && db().from('admin_logs').insert({ action: a, username: 'admin', created_at: new Date().toISOString() });

  const HTML = `
  <div id="onsiteSection" class="section-title">📋 Onsite Valuations <span class="count-pill" id="osCount">0 total</span></div>
  <div class="stats-grid">
    <div class="stat-card"><div class="stat-value" id="osOfficers">0</div><div class="stat-label">Active officers</div></div>
    <div class="stat-card"><div class="stat-value" id="osPending">0</div><div class="stat-label">Awaiting approval</div></div>
    <div class="stat-card"><div class="stat-value" id="osDrafts">0</div><div class="stat-label">Drafts in progress</div></div>
    <div class="stat-card"><div class="stat-value" id="osFinal">0</div><div class="stat-label">Final valuations</div></div>
  </div>
  <div class="card" style="margin-bottom:28px;">
    <div class="card-header"><h3>Valuation officers</h3><span class="badge badge-info" id="osBadge">Loading</span></div>
    <div class="data-table-wrap"><table class="data-table">
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Licence</th><th>Role</th><th>Status</th><th>Joined</th><th>Actions</th></tr></thead>
      <tbody id="osOfficerBody"><tr class="row-empty"><td colspan="8">Loading officers...</td></tr></tbody>
    </table></div>
    <div class="action-bar">
      <button class="action-btn success" id="osReload">🔄 Refresh</button>
      <a class="action-btn" href="onsite-valuation-engine.html" target="_blank" rel="noopener">↗ Open onsite app</a>
    </div>
  </div>
  <div class="card" style="margin-bottom:28px;">
    <div class="card-header"><h3>Onsite valuation records</h3></div>
    <div class="filter-bar">
      <input type="text" id="osSearch" placeholder="Search ref, plate, chassis, make...">
      <select id="osPurpose"><option value="">All purposes</option>${Object.entries(PN).map(([k, v]) => `<option value="${k}">${v}</option>`).join('')}</select>
      <select id="osStatus"><option value="">All statuses</option><option value="draft">Draft</option><option value="final">Final</option></select>
      <select id="osOfficer"><option value="">All officers</option></select>
    </div>
    <div class="data-table-wrap"><table class="data-table">
      <thead><tr><th>Ref</th><th>Vehicle</th><th>Purpose</th><th>Officer</th><th>Value</th><th>Conf.</th><th>Status</th><th>Updated</th><th></th></tr></thead>
      <tbody id="osValBody"><tr class="row-empty"><td colspan="9">Loading...</td></tr></tbody>
    </table></div>
    <div class="action-bar"><button class="action-btn" id="osCsv">📊 Export CSV</button></div>
  </div>`;

  const MODAL = `
  <div class="modal-overlay" id="osModal"><div class="modal-content wide">
    <button class="close-modal" data-act="close">✕</button>
    <h2 id="osMTitle">Valuation</h2><p class="sub" id="osMSub"></p>
    <div class="kv-list" id="osMKv"></div>
    <h4 style="font-size:13px;color:var(--text-muted);margin:12px 0 6px;">Calculation</h4><div class="kv-list" id="osMCalc"></div>
    <h4 style="font-size:13px;color:var(--text-muted);margin:12px 0 6px;">Issues found</h4><div class="kv-list" id="osMIssues"></div>
    <h4 style="font-size:13px;color:var(--text-muted);margin:12px 0 6px;">Photos</h4><div id="osMPhotos" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
    <div class="modal-actions">
      <button class="btn btn-danger" id="osReopen" data-act="reopen">↩️ Reopen as draft</button>
      <button class="btn btn-secondary" data-act="close">Close</button>
    </div>
  </div></div>`;

  function inject() {
    const anchor = $('auditSection'); if (!anchor) return false;
    anchor.insertAdjacentHTML('beforebegin', HTML);
    document.body.insertAdjacentHTML('beforeend', MODAL);
    const nav = document.querySelector('.section-nav');
    if (nav) nav.insertAdjacentHTML('beforeend', '<a href="#onsiteSection">📋 Onsite Valuations</a>');
    ['osSearch', 'osPurpose', 'osStatus', 'osOfficer'].forEach(id => $(id).addEventListener('input', renderVals));
    $('osReload').onclick = load; $('osCsv').onclick = exportCsv;
    $('onsiteSection').parentElement.addEventListener('click', onClick);
    $('osModal').addEventListener('click', e => { if (e.target === $('osModal') || e.target.dataset.act === 'close') closeModal(); else onClick(e); });
    return true;
  }

  async function load() {
    const c = db(); if (!c) return;
    const { data: { session } } = await c.auth.getSession(); meId = session?.user?.id;
    const [o, v] = await Promise.all([
      c.from('valuation_officers').select('*').order('created_at', { ascending: false }),
      c.from('onsite_valuations').select('*').order('updated_at', { ascending: false }).limit(500)
    ]);
    const err = o.error || v.error;
    officers = o.data || []; vals = v.data || [];
    const b = $('osBadge');
    b.textContent = err ? 'Setup needed: ' + err.message : '● Connected';
    b.className = 'badge ' + (err ? 'badge-danger' : 'badge-success');
    $('osOfficer').innerHTML = '<option value="">All officers</option>' + officers.map(x => `<option value="${x.id}">${esc(x.full_name)}</option>`).join('');
    renderOfficers(); renderVals();
  }

  function renderOfficers() {
    $('osOfficers').textContent = officers.filter(o => o.active).length;
    $('osPending').textContent = officers.filter(o => !o.active).length;
    $('osOfficerBody').innerHTML = officers.length ? officers.map(o => `
      <tr><td>${esc(o.full_name)}</td><td>${esc(o.email || '-')}</td><td>${esc(o.phone || '-')}</td><td>${esc(o.licence_no || '-')}</td>
      <td>${esc(o.role)}</td><td><span class="status-pill ${o.active ? 'active' : 'pending'}">${o.active ? 'active' : 'pending'}</span></td>
      <td>${when(o.created_at)}</td>
      <td>${o.id === meId ? '<span class="sub">you</span>' : `
        <button class="mini-btn ${o.active ? 'reject' : 'approve'}" data-act="toggle" data-id="${o.id}">${o.active ? 'Deactivate' : 'Approve'}</button>
        <button class="mini-btn" data-act="role" data-id="${o.id}">${o.role === 'admin' ? 'Make officer' : 'Make admin'}</button>`}</td></tr>`).join('')
      : '<tr class="row-empty"><td colspan="8">No officers yet. They appear after signing up on the onsite page.</td></tr>';
  }

  function renderVals() {
    $('osDrafts').textContent = vals.filter(v => v.status === 'draft').length;
    $('osFinal').textContent = vals.filter(v => v.status === 'final').length;
    $('osCount').textContent = vals.length + ' total';
    const q = $('osSearch').value.toLowerCase().trim(), p = $('osPurpose').value, s = $('osStatus').value, of = $('osOfficer').value;
    const name = id => (officers.find(o => o.id === id) || {}).full_name || '-';
    const rows = vals.filter(v => {
      const ve = v.vehicle || {};
      const hay = [v.ref, ve.plate, ve.chassis, ve.make, ve.model].join(' ').toLowerCase();
      return (!q || hay.includes(q)) && (!p || v.purpose === p) && (!s || v.status === s) && (!of || v.officer_id === of);
    });
    $('osValBody').innerHTML = rows.length ? rows.slice(0, 200).map(v => {
      const ve = v.vehicle || {};
      return `<tr><td>${esc(v.ref)}</td><td>${esc([ve.make, ve.model, ve.plate].filter(Boolean).join(' ') || '-')}</td><td>${PN[v.purpose] || v.purpose}</td>
      <td>${esc(name(v.officer_id))}</td><td>${v.final_value ? kes(v.final_value) : '-'}</td><td>${v.confidence ?? '-'}%</td>
      <td><span class="status-pill ${v.status === 'final' ? 'completed' : 'pending'}">${v.status}</span></td><td>${when(v.updated_at)}</td>
      <td><button class="mini-btn" data-act="view" data-id="${v.id}">🔍 View</button></td></tr>`;
    }).join('') : '<tr class="row-empty"><td colspan="9">No onsite valuations match.</td></tr>';
  }

  let curId = null;
  async function openModal(id) {
    const v = vals.find(x => x.id === id); if (!v) return;
    curId = id;
    const ve = v.vehicle || {}, r = v.result || {}, inp = v.inputs || {};
    const kv = (k, val) => `<div class="kv-row"><span class="k">${k}</span><span class="v">${esc(val ?? '-')}</span></div>`;
    const off = (officers.find(o => o.id === v.officer_id) || {}).full_name || '-';
    $('osMTitle').textContent = [ve.make, ve.model, ve.plate].filter(Boolean).join(' ') || v.ref;
    $('osMSub').textContent = `${v.ref} · ${PN[v.purpose] || v.purpose} · ${v.status} · officer ${off}`;
    $('osMKv').innerHTML = kv('Chassis', ve.chassis) + kv('Engine no.', ve.engine_no) + kv('Year', ve.yom) + kv('Odometer', ve.mileage ? ve.mileage + ' km' : '-') +
      kv('Origin', ve.origin) + kv('Owner / requester', ve.owner) + kv('Valuation date', inp.date) + kv('Location', inp.location) +
      kv('Final value', v.final_value ? kes(v.final_value) : '-') + kv('Range', v.range_low ? kes(v.range_low) + ' to ' + kes(v.range_high) : '-') + kv('Confidence', (v.confidence ?? '-') + '%');
    $('osMCalc').innerHTML = kv('Base', kes(r.base)) + (r.lines || []).map(l => kv(l[0], (l[1] < 0 ? '-' : '+') + kes(Math.abs(l[1])))).join('');
    const issues = Object.entries(v.answers || {}).filter(([, a]) => a === 'issue');
    $('osMIssues').innerHTML = issues.length ? issues.map(([k]) => kv(k, (v.notes || {})[k] || 'Issue')).join('') : kv('None recorded', '');
    $('osReopen').style.display = v.status === 'final' ? '' : 'none';
    const ph = $('osMPhotos'); ph.innerHTML = '';
    $('osModal').classList.add('open');
    const paths = inp.photos || [];
    if (paths.length) {
      const { data } = await db().storage.from('valuation-photos').createSignedUrls(paths, 3600);
      (data || []).forEach(x => { if (x.signedUrl) ph.insertAdjacentHTML('beforeend', `<a href="${x.signedUrl}" target="_blank" rel="noopener"><img src="${x.signedUrl}" alt="Inspection photo" style="width:110px;height:84px;object-fit:cover;border-radius:6px;border:1px solid var(--border)"></a>`); });
    } else ph.innerHTML = '<span class="sub">No photos uploaded.</span>';
  }
  const closeModal = () => { $('osModal').classList.remove('open'); curId = null; };

  async function onClick(e) {
    const b = e.target.closest('[data-act]'); if (!b) return;
    const act = b.dataset.act, id = b.dataset.id, c = db();
    if (act === 'view') return openModal(id);
    if (act === 'toggle' || act === 'role') {
      const o = officers.find(x => x.id === id); if (!o) return;
      const patch = act === 'toggle' ? { active: !o.active } : { role: o.role === 'admin' ? 'officer' : 'admin' };
      if (patch.role === 'admin' && !confirm(`Make ${o.full_name} an admin? Admins can see all valuations and approve officers.`)) return;
      const { error } = await c.from('valuation_officers').update(patch).eq('id', id);
      if (error) return toast(error.message, 'error');
      log(`Officer ${o.full_name}: ${act === 'toggle' ? (patch.active ? 'approved' : 'deactivated') : 'role set to ' + patch.role}`);
      toast('Officer updated'); return load();
    }
    if (act === 'reopen' && curId) {
      if (!confirm('Reopen this valuation as a draft? The officer can edit and finalise it again.')) return;
      const { data, error } = await c.from('onsite_valuations').update({ status: 'draft' }).eq('id', curId).select();
      if (error || !data || !data.length) return toast(error ? error.message : 'Blocked (run onsite_admin_migration.sql)', 'error');
      log(`Onsite valuation ${data[0].ref} reopened as draft`);
      toast('Valuation reopened'); closeModal(); load();
    }
  }

  function exportCsv() {
    const rows = [['Ref', 'Purpose', 'Status', 'Make', 'Model', 'Plate', 'Chassis', 'Value', 'Confidence', 'Officer', 'Updated']];
    vals.forEach(v => { const ve = v.vehicle || {}; rows.push([v.ref, v.purpose, v.status, ve.make, ve.model, ve.plate, ve.chassis, v.final_value, v.confidence, (officers.find(o => o.id === v.officer_id) || {}).full_name, v.updated_at]); });
    const csv = rows.map(r => r.map(x => `"${String(x ?? '').replace(/"/g, '""')}"`).join(',')).join('\n');
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = 'onsite-valuations-' + new Date().toISOString().slice(0, 10) + '.csv'; a.click();
  }

  // Wait until the admin has logged in and the dashboard is visible
  const t = setInterval(() => {
    const dash = $('dashboardScreen');
    if (injected || !dash || dash.classList.contains('hidden') || !db()) return;
    if (inject()) { injected = true; clearInterval(t); load(); }
  }, 600);
})();
